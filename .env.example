# Tujuan: Panduan template environment variables untuk konfigurasi Next.js (Supabase & Gemini).
# Caller: Developer manual (.env.local)
# Dependensi: Supabase Dashboard, Gemini API
# Side Effects: Menyediakan parameter koneksi database & API key lokal.

# Supabase API Credentials (didapatkan dari Dashboard Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Gemini API Key Bawaan (Server-side proxy fallback jika user tidak input key sendiri)
GEMINI_API_KEY=AIzaSy...
